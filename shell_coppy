import Quickshell
import Quickshell.Wayland
import QtQuick
import QtQuick.Layouts

ShellRoot {
    property string font: "JetBrainsMono Nerd Font"
    property int font_size: 16

    PanelWindow {
        anchors { top: true; left: true; right: true }
        height: 30
        color: "transparent"
        WlrLayershell.layer: WlrLayer.Top

        // bar background
        Rectangle {
            anchors.fill: parent
            color: "#30000000"

            RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 8
                anchors.rightMargin: 8

                // ── LEFT: workspaces ──
                Row {
                    spacing: 20

                    Repeater {
                        model: 4
                        delegate: Rectangle {
                            width: 10
                            height: 24
                            color:  "transparent"

                            Text {
                                anchors.centerIn: parent
                                text: index + 1
                                color: index === 0 ? "#ffffff" : "#666666"
                                font.pixelSize: font_size
                                font.family: fontFamily
                                font.bold: index === 0
                            }
                        }
                    }
                }

                // ── CENTER: clock ──
                Item { Layout.fillWidth: true }

                Text {
                    Layout.alignment: Qt.AlignHCenter
                    id: clockText
                    color: "white"
                    font.pixelSize: font_size
                    font.family: font

                    Timer {
                        interval: 1000
                        running: true
                        repeat: true
                        onTriggered: clockText.text = Qt.formatTime(new Date(), "hh:mm:ss AP") +
                                     " | " + Qt.formatDate(new Date(), "dddd - dd/MM/yy")
                    }

                    Component.onCompleted: text = Qt.formatTime(new Date(), "hh:mm:ss AP") +
                                           " | " + Qt.formatDate(new Date(), "dddd - dd/MM/yy")
                }

                Item { Layout.fillWidth: true }

                // ── RIGHT: volume + battery ──
                Row {
                    spacing: 6

                    // volume pill
                    Rectangle {
                        width: volumeLabel.implicitWidth + 12
                        height: 22
                        radius: 6
                        color: "#7b8fb5"

                        Text {
                            id: volumeLabel
                            anchors.centerIn: parent
                            text: "25% 󰕾"
                            color: "black"
                            font.pixelSize: font_size
                            font.family: font
                            font.bold: true
                        }
                    }

                    // battery pill
                    Rectangle {
                        width: batteryLabel.implicitWidth + 12
                        height: 22
                        radius: 6
                        color: "#2ecc71"

                        Text {
                            id: batteryLabel
                            anchors.centerIn: parent
                            text: "80% —"
                            color: "black"
                            font.pixelSize: font_size
                            font.family: font
                            font.bold: true
                        }
                    }
                }
            }
        }
    }
}
